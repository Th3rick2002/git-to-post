# Copy to .env.local for Next.js and the Convex CLI.
# Convex secrets are set on the deployment, not in this file:
#   npx convex env set KEY value

# --- Next.js / Convex CLI ---
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment-name.convex.site

# --- Convex backend (convex/convex.config.ts) ---
# Optional GitHub API token for private repos and higher rate limits.
GITHUB_TOKEN=
# HMAC secret for POST /github-webhook. If empty, signatures are not checked.
GITHUB_WEBHOOK_SECRET=
# Required for text and abstract image generation.
OPENROUTER_API_KEY=
OPENROUTER_APP_NAME=PublicaDev
OPENROUTER_SITE_URL=http://localhost:3000
# Defaults used by the post writer if unset:
OPENROUTER_TEXT_MODEL=openai/gpt-5.6-luna
# OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# --- Next.js Better Auth (GitHub only) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_APP_SLUG=publicadev
BETTER_AUTH_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# --- Convex GitHub App (set on the deployment) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
